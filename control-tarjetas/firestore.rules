rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Configuración de la App (Verificación de Versión)
    // Permitir a cualquiera leer la configuración para buscar actualizaciones
    match /app_config/{document=**} {
      allow read: if true;
      allow write: if false; // Solo admins vía consola
    }

    // 2. Datos de Usuario (Sincronización)
    // Los usuarios solo pueden leer/escribir sus PROPIOS datos
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Por defecto: Denegar todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
